{
  "name": "interview-simulation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-lint": "npm run lint && vite",
    "dev:no-lint": "vite",
    "dev:watch": "concurrently \"npm run lint:watch\" \"vite\"",
    "build": "vite build",
    "build:no-lint": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings 0",
    "lint:errors-only": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "lint:watch": "eslint .",
    "preview": "vite preview",
    "start": "npm run dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.14.3",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "dayjs": "^1.11.18",
    "eventemitter3": "^5.0.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.0",
    "react-rating": "^2.0.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.3",
    "react-simple-star-rating": "^5.1.7",
    "redux": "^5.0.1",
    "redux-saga": "^1.3.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ]
  }
}
